{
    "name": "cors/adminer",
    "type": "pimcore-bundle",
    "description": "CORS - Adminer",
    "keywords": [
        "cors",
        "pimcore"
    ],
    "homepage": "https://www.cors.gmbh",
    "license": "MIT",
    "authors": [
        {
            "name": "CORS GmbH",
            "email": "office@cors.gmbh",
            "homepage": "https://www.cors.gmbh/",
            "role": "TEAM"
        }
    ],
    "require": {
        "pimcore/pimcore": "^2026.2",
        "pimcore/studio-ui-bundle": "^2026.2",
        "vrana/adminer": "^4.17"
    },
    "require-dev": {
        "symfony/runtime": "^6.4",
        "symfony/dotenv": "^7.3",
        "coreshop/test-setup": "dev-main",
        "pimcore/opensearch-client": "^2026.1"
    },
    "autoload": {
        "psr-4": {
            "CORS\\Bundle\\AdminerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "Kernel.php"
        ],
        "psr-4": {
            "App\\": "dev",
            "Pimcore\\Model\\DataObject\\": "var/classes/DataObject"
        }
    },
    "extra": {
        "pimcore": {
            "bundles": [
                "CORS\\Bundle\\AdminerBundle\\CORSAdminerBundle"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-5hbx-ykrq-c4p8": "CVE-2026-25892, unauthenticated DoS via ?script=version. Adminer is only reachable behind the Pimcore admin check in DefaultController, so the unauthenticated endpoint is not exposed. Fixed upstream in 5.4.2, but 5.x/6.x namespace the plugin API (Adminer\\Plugin) and require a rewrite of the integration."
                }
            }
        }
    }
}
